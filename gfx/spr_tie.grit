#-------------------------------------------------------
# 敵機 TIE 16x16 x2 フレーム
#-------------------------------------------------------

# タイル形式 / 4bpp (16色)
-g
-gt
-gB4

# メタタイル = スプライト1枚の大きさ(タイル単位)
# grit がスプライト用の 1D タイル順で並べてくれる
-Mw2
-Mh2

# 16色パレットを出力 (SPRITE_PALETTE のバンクに載せる)
-p
-pn16

# マゼンタを透過色(index 0)に
-gTFF00FF

# マップは不要
-m!
